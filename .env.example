# ---------------------------------------------------------------------------
# NamazGo — Ortam Değişkenleri (şablon)
#
# Bu dosyayı kopyalayıp `.env.local` olarak kaydedin ve değerleri kendi
# ortamınıza göre doldurun:
#
#   cp .env.example .env.local
#
# NOT: Next.js'te yalnızca `NEXT_PUBLIC_` ön ekli değişkenler tarayıcıya
# gönderilir. Gizli anahtarları (API secret, DB şifresi vb.) ASLA
# `NEXT_PUBLIC_` ile başlatmayın.
# ---------------------------------------------------------------------------

# Backend REST API'nin kök adresi.
# axios `baseURL` olarak kullanılır ve servisler bunun üzerine
# `/auth/login`, `/guides/wudu` gibi yolları ekler.
# Sonunda `/` OLMAMALI — aksi halde çift slash oluşur.
# Kullanım: src/lib/axios.ts
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Uygulamanın herkese açık kök adresi.
# SEO metadata, Open Graph ve canonical URL üretiminde kullanılır.
# Tanımlanmazsa src/config/site.ts içindeki "https://namazgo.com/" varsayılanı geçerli olur.
# Kullanım: src/config/site.ts
NEXT_PUBLIC_SITE_URL=http://localhost:3000
